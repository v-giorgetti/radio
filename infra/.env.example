# Copy to infra/.env and fill in. Never commit infra/.env.

# Host dashboard password, used on the FIRST start only (at least 12 characters).
# Afterwards the stored hash is used; change it in the dashboard under Settings › Host account.
STATION_HOST_PASSWORD=

# Set to 1 to reset a forgotten password to STATION_HOST_PASSWORD (signs out every session).
# Remove it again after one start.
STATION_RESET_PASSWORD=0

# The site is served over HTTPS by Caddy, so session cookies must be Secure.
# Use 0 only when testing locally over plain http://.
STATION_SECURE_COOKIES=1

# Host port the container binds to on 127.0.0.1 (Caddy proxies to it).
STATION_PORT=8080
